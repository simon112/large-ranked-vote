# System unit: runs the poll server as an unprivileged, sandboxed user.
# Installed to /etc/systemd/system/poll.service by deploy.sh.
[Unit]
Description=Ranked poll server (Borda), sandboxed
Requires=poll.socket
After=poll.socket

[Service]
User=poll
Group=poll
# -I: ignore PYTHON* env and user site; -S: no site.py, so no dist-packages or distro hooks.
ExecStart=/usr/bin/python3.12 -I -S /opt/poll/server.py
Environment=POLL_DB=/var/lib/poll/polls.db
StateDirectory=poll
StateDirectoryMode=0700
UMask=0077
Restart=on-failure

# Filesystem: an allowlist. The service's root is an empty, root-owned directory; only what
# the server actually opens (traced with strace) is mounted into it. No /etc, /home, /srv,
# other /opt, other /var/lib, /usr/share, or any binary but python. Shared libraries are the
# one coarse grant: the whole multiarch dir, so library upgrades don't break the service.
# /lib and /lib64 are symlinks into /usr on the host, so the libraries are mounted at both
# paths. python3.12 is Ubuntu 24.04's; a distro Python upgrade means updating the paths.
# StateDirectory= mounts /var/lib/poll in by itself.
RootDirectory=/opt/poll-root
BindReadOnlyPaths=/usr/bin/python3.12 /usr/lib/python3.12 /usr/lib/locale/C.utf8
BindReadOnlyPaths=/usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu /usr/lib64:/lib64
BindReadOnlyPaths=/opt/poll
# No procfs or sysfs: /proc and /sys are only empty stub directories (ProtectProc=, ProcSubset=,
# ProtectKernelTunables= and ProtectControlGroups= would each mount the real ones back in).
MountAPIVFS=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices gives a minimal /dev, but bind-mounts the host's /dev/shm, /dev/pts and
# /dev/hugepages into it; the server uses none of them, so cover them with empty read-only tmpfs.
PrivateDevices=yes
TemporaryFileSystem=/dev/shm:ro /dev/pts:ro /dev/hugepages:ro

# Network: no sockets of its own. The listening socket comes from poll.socket (which holds the
# localhost-only address filter). RestrictAddressFamilies=none makes socket(2) fail for every
# family; per systemd.exec(5) this is reliable on x86-64 when combined with
# SystemCallArchitectures=native (set below), and only socketpair(2), which makes a connected
# AF_UNIX pair and reaches nothing, is exempt. PrivateNetwork= is left off on purpose: it
# mounts a fresh sysfs into the root (namespace.c, MOUNT_PRIVATE_SYSFS), and with no way to
# create a socket it would add little.
RestrictAddressFamilies=none
IPAddressDeny=any

# Privileges and kernel surface. Not set, on purpose: ProtectKernelTunables, ProtectControlGroups
# and ProtectHostname work by binding the host's /proc and /sys read-only, which would put them
# back into the empty root; with no capabilities the service can't change any of those anyway.
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RemoveIPC=yes
PrivateIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Resource caps so a flood can't take the box down with it.
MemoryMax=256M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
